{
  "name": "eventwiz-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server",
    "db:migrate": "npm run db:migrate -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
