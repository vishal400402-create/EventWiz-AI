# PostgreSQL / Neon. Copy your local Neon connection string here; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require

# Default is demo. Set APP_MODE=live only after completing the Meta setup.
PORT=8787
APP_MODE=demo
WEB_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
META_APP_SECRET=
